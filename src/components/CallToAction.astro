---
import { translations } from '../translations';
import { Image } from 'astro:assets';
import mindsetImage from '../assets/mindset.jpg';
---

<section id="call-to-action" class="bg-surface-alt py-16 sm:py-20 lg:py-24">
    <div class="container mx-auto px-4 sm:px-6">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 sm:gap-12 lg:gap-16 items-center">
            <div class="order-2 lg:order-1">
                <Image 
                    src={mindsetImage} 
                    alt="Productos naturales para el bienestar" 
                    class="w-full h-64 sm:h-80 lg:h-96 object-cover rounded-sm shadow-sm"
                    width={800}
                    height={600}
                />
            </div>
            <div class="order-1 lg:order-2 max-w-xl mx-auto lg:mx-0 text-center lg:text-left">
                <h2 class="text-2xl sm:text-3xl lg:text-4xl mb-4 sm:mb-6 italic leading-tight text-brand-green" data-lang-target="callToActionTitle">{translations.es.callToActionTitle}</h2>
                <p class="text-text-muted leading-relaxed mb-6 sm:mb-8 text-sm sm:text-base" data-lang-target="callToActionText">
                    {translations.es.callToActionText}
                </p>
                <a 
                    href="#shop" 
                    class="inline-block bg-brand-green text-sm text-white px-6 py-3 rounded-md hover:bg-brand-green-dark focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-green focus-visible:ring-offset-2 focus-visible:ring-offset-surface-alt transition-colors duration-250 ease-smooth"
                >
                    {translations.es.exploreCollection}
                </a>
            </div>
        </div>
    </div>
</section>