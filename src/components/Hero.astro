---
import { Image } from 'astro:assets';
import heroImage from '../assets/hero.jpg';
import { translations } from '../translations';
---

<section class="relative min-h-[100vh] sm:min-h-[80vh] lg:min-h-[90vh] flex items-center justify-center overflow-hidden">
    <div class="absolute inset-0 z-0">
        <Image 
            src={heroImage} 
            alt="Hiervas naturales y productos botánicos de AlfaBotánica" 
            class="w-full h-full rounded-none object-cover object-center opacity-40"
            loading="eager"
            width={1920}
            height={1080}
        />
    </div>
    <div class="relative z-10 text-center px-4 sm:px-6 max-w-4xl mx-auto">
        <span class="uppercase tracking-[0.2em] sm:tracking-[0.3em] text-xs sm:text-sm mb-3 sm:mb-4 block text-brand-green" data-lang-target="heroSubtitle">{translations.es.heroSubtitle}</span>
        <h1 class="text-3xl sm:text-5xl md:text-6xl lg:text-7xl mb-4 sm:mb-6 leading-tight text-brand-green" data-lang-target="heroTitle">{translations.es.heroTitle}</h1>
        <a 
            href="#shop" 
            class="inline-block bg-brand-green text-white px-6 sm:px-10 py-3 sm:py-4 uppercase tracking-widest text-xs hover:bg-brand-green-dark hover:text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-green focus-visible:ring-offset-2 focus-visible:ring-offset-white transition-all duration-250 ease-smooth transform hover:scale-105" 
            data-lang-target="exploreCollection"
        >
            {translations.es.exploreCollection}
        </a>
    </div>
</section>