---
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import FallbackImage from '../assets/hero.jpg';
import {
	SITE_TITLE,
	SITE_DESCRIPTION,
	SITE_URL,
	SITE_OWNER,
	SITE_EMAIL,
	SITE_WHATSAPP,
	SITE_LOGO,
	SITE_TWITTER_CREATOR,
	SITE_TWITTER_SITE,
	SITE_CITY,
	SITE_DEPARTMENT,
	SITE_COUNTRY,
	SITE_LATITUDE,
	SITE_LONGITUDE,
	SITE_OPENING_HOURS,
	SITE_PRICE_CURRENCY,
} from '../consts';
import { ClientRouter } from "astro:transitions";
import { generateStructuredData } from '../utils/seo';

interface Props {
	title?: string;
	description?: string;
	heroImage?: ImageMetadata;
	author?: string;
	keywords?: string[];
	type?: 'website' | 'article' | 'product';
	price?: string;
	currency?: string;
	availability?: 'in_stock' | 'out_of_stock' | 'preorder';
	category?: string;
	brand?: string;
	sku?: string;
	publishedTime?: string;
	modifiedTime?: string;
	noindex?: boolean;
}

const {
	title = SITE_TITLE,
	description = SITE_DESCRIPTION,
	heroImage = FallbackImage,
	author = SITE_OWNER,
	keywords = [],
	type = 'website',
	price,
	currency = SITE_PRICE_CURRENCY,
	availability = 'in_stock',
	category,
	brand = SITE_TITLE,
	sku,
	publishedTime,
	modifiedTime,
	noindex = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, SITE_URL);

let imageURL: URL;
if (heroImage?.src) {
    const imagePath = heroImage.src.startsWith('/') ? heroImage.src : `/${heroImage.src}`;
    imageURL = new URL(imagePath, SITE_URL);
} else {
    imageURL = new URL(SITE_LOGO, SITE_URL);
}

const seoTitle = title === SITE_TITLE ? title : `${title} | ${SITE_TITLE}`;

const structuredData = generateStructuredData({
	organization: {
		name: SITE_TITLE,
		url: SITE_URL,
		logo: new URL(SITE_LOGO, SITE_URL).toString(),
		phone: SITE_WHATSAPP,
		email: SITE_EMAIL,
	},
	website: {
		name: SITE_TITLE,
		url: SITE_URL,
		description: SITE_DESCRIPTION,
	},
	localBusiness: {
		name: SITE_TITLE,
		url: SITE_URL,
		logo: new URL(SITE_LOGO, SITE_URL).toString(),
		phone: SITE_WHATSAPP,
		email: SITE_EMAIL,
		address: {
			addressLocality: SITE_CITY,
			addressRegion: SITE_DEPARTMENT,
			addressCountry: SITE_COUNTRY,
		},
		geo: {
			latitude: SITE_LATITUDE,
			longitude: SITE_LONGITUDE,
		},
		openingHours: SITE_OPENING_HOURS,
		priceRange: '$$',
	},
	product: type === 'product' && price ? {
		name: title,
		description: description,
		image: imageURL.toString(),
		category: category || 'Botanical Products',
		price: price,
		currency: currency,
		availability: availability,
		brand: brand,
		sku: sku,
	} : undefined,
});
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="apple-touch-icon" sizes="180x180" href="/favicon_io/apple-touch-icon.png">
<link rel="icon" type="image/png" sizes="32x32" href="/favicon_io/favicon-32x32.png">
<link rel="icon" type="image/png" sizes="16x16" href="/favicon_io/favicon-16x16.png">
<link rel="manifest" href="/favicon_io/site.webmanifest">
<link rel="sitemap" href="/favicon_io/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', SITE_URL)}
/>
<meta name="generator" content={Astro.generator} />
<meta name="author" content={author} />
<meta name="publisher" content={SITE_OWNER} />
{keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}

<meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"} />
<meta name="googlebot" content="index, follow" />
<meta name="bingbot" content="index, follow" />
<meta name="language" content="es-CO" />
<meta name="geo.region" content={`CO-${SITE_DEPARTMENT.toUpperCase().slice(0, 2)}`} />
<meta name="geo.placename" content={SITE_CITY} />
<meta name="geo.position" content={`${SITE_LATITUDE};${SITE_LONGITUDE}`} />
<meta name="ICBM" content={`${SITE_LATITUDE}, ${SITE_LONGITUDE}`} />

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="preload" href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;0,800;0,900;1,400&display=swap" as="style" />
<link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;0,800;0,900;1,400&display=swap" rel="stylesheet" />

<link rel="canonical" href={canonicalURL} />

<title>{seoTitle}</title>
<meta name="title" content={seoTitle} />
<meta name="description" content={description} />

<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={seoTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageURL} />
<meta property="og:image:alt" content={title} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:locale" content="es_CO" />

<meta property="business:contact_data:phone_number" content={`+${SITE_WHATSAPP}`} />
<meta property="business:contact_data:country_name" content="Colombia" />

{type === 'product' && price && (
	<>
		<meta property="product:price:amount" content={price} />
		<meta property="product:price:currency" content={currency} />
		<meta property="product:availability" content={availability} />
		{category && <meta property="product:category" content={category} />}
		{brand && <meta property="product:brand" content={brand} />}
		{sku && <meta property="product:sku" content={sku} />}
	</>
)}

{(type === 'article' || type === 'product') && publishedTime && (
	<meta property="article:published_time" content={publishedTime} />
)}
{(type === 'article' || type === 'product') && modifiedTime && (
	<meta property="article:modified_time" content={modifiedTime} />
)}
<meta property="article:author" content={author} />
{category && <meta property="article:section" content={category} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content={SITE_TWITTER_SITE} />
<meta name="twitter:creator" content={SITE_TWITTER_CREATOR} />
<meta name="twitter:url" content={canonicalURL} />
<meta name="twitter:title" content={seoTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageURL} />
<meta name="twitter:image:alt" content={title} />

<meta property="og:phone_number" content={SITE_WHATSAPP} />
<meta name="whatsapp:title" content={seoTitle} />
<meta name="whatsapp:description" content={description} />
<meta name="whatsapp:image" content={imageURL} />

<meta name="theme-color" content="#f5f5dc" />
<meta name="color-scheme" content="light" />
<meta name="mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="default" />

<script type="application/ld+json" set:html={structuredData} />

<ClientRouter />
