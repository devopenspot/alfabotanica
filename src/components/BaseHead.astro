---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import { ClientRouter } from 'astro:transitions';
import FallbackImage from '../assets/hero.jpg';
import { SITE_TITLE } from '../consts';

interface Props {
	title: string;
	description: string;
	heroImage?: ImageMetadata;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site || Astro.url.origin);

const { title, description, heroImage = FallbackImage } = Astro.props;

// Ensure absolute URL for social images
const socialImageURL = new URL(heroImage.src, Astro.url.origin);
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<ClientRouter />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url.href} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={socialImageURL.href} />
<meta property="og:image:secure_url" content={socialImageURL.href} />
{heroImage.format && <meta property="og:image:type" content={`image/${heroImage.format === 'jpg' ? 'jpeg' : heroImage.format}`} />}
{heroImage.width && <meta property="og:image:width" content={heroImage.width.toString()} />}
{heroImage.height && <meta property="og:image:height" content={heroImage.height.toString()} />}
<meta property="og:image:alt" content={title} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url.href} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={socialImageURL.href} />

<!-- Icons and Other Links -->
<link rel="apple-touch-icon" sizes="180x180" href="/favicon_io/apple-touch-icon.png">
<link rel="icon" type="image/png" sizes="32x32" href="/favicon_io/favicon-32x32.png">
<link rel="icon" type="image/png" sizes="16x16" href="/favicon_io/favicon-16x16.png">
<link rel="manifest" href="/favicon_io/site.webmanifest">
<link rel="sitemap" href="/favicon_io/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', Astro.url.origin).href}
/>
<meta name="generator" content={Astro.generator} />

<!-- Font preloads -->
<link rel="preload" href="/fonts/atkinson-regular.woff" as="font" type="font/woff" crossorigin />
<link rel="preload" href="/fonts/atkinson-bold.woff" as="font" type="font/woff" crossorigin />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL.href} />
