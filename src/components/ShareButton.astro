---
import SoonerNotification from './SoonerNotification.astro';
---

<SoonerNotification />

<button 
    onclick="copyToClipboard()" 
    class="w-full bg-white border border-border-light inline-flex py-3 px-5 rounded-lg items-center hover:bg-brand-green hover:text-white hover:border-brand-green focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-green focus-visible:ring-offset-2 transition-all duration-250 ease-smooth"
    aria-label="Copiar enlace del producto"
>
 	<span class="icon-[ci--share] mr-4 w-5 h-5 text-brand-green group-hover:text-white transition-colors duration-250 ease-smooth"></span>
 	<span class="flex items-start flex-row md:flex-col leading-none">
 		<span class="title-font font-medium md:text-xs md:mb-1 text-brand-green group-hover:text-white transition-colors duration-250 ease-smooth">Compartir</span>
 		<span class="title-font font-medium ml-1 md:ml-0 text-brand-green group-hover:text-white transition-colors duration-250 ease-smooth">Enlace</span>
 	</span>
</button>

<script is:inline>
  const copyToClipboard = function () {
    navigator.clipboard.writeText(window.location.href).then(() => {
      window.showSoonerNotification('Enlace copiado listo para Compartirlo!');
    }).catch(err => {
      console.error('Error al copiar: ', err);
    });
  }
</script>