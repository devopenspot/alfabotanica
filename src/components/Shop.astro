---
import { translations } from '../translations';
import { getCollection } from 'astro:content';
import ProductCard from './ProductCard.astro';

interface Props {
	excludeId?: number;
}

const { excludeId } = Astro.props;

const products = await getCollection('products');
const filteredProducts = excludeId 
	? products.filter(p => p.data.id !== excludeId)
	: products;
---

<section id="shop" class="container mx-auto px-4 sm:px-6 py-16 sm:py-20 lg:py-24" aria-labelledby="shop-heading">
	
    <div class="flex flex-col lg:flex-row justify-between items-start lg:items-end mb-8 sm:mb-12">
        <div class="max-w-xl">
            <h2 id="shop-heading" class="text-3xl sm:text-4xl lg:text-5xl mb-2 sm:mb-3 text-brand-green" data-lang-target="openingCollection">{translations.es.openingCollection}</h2>
            <p class="text-text-muted italic text-sm sm:text-base leading-relaxed" data-lang-target="collectionSubtitle">{translations.es.collectionSubtitle}</p>
        </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" role="list">

		{filteredProducts.sort((a, b) => a.data.id - b.data.id).map((product) => (
			<div role="listitem">
			    <ProductCard product={product} key={product.id} />
			</div>
		))}

    </div>
</section>