---
import { translations } from '../translations';

import { SITE_WHATSAPP } from '../consts';

const message = encodeURIComponent(`Hola, estoy interesado en los productos.`);

const whatsappUrl = `https://wa.me/${SITE_WHATSAPP}?text=${message}`;

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 bg-surface-cream backdrop-blur-md border-b border-border-light">
    <nav class="container mx-auto px-4 sm:px-6 py-4" aria-label="Navegación principal">
        <div class="flex justify-between items-center">
            <a href="/" class="focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-green focus-visible:ring-offset-2 rounded-lg tracking-[0.3em] uppercase text-3xl" aria-label="Alfabotánica - Inicio">
				 {"Alfabotánica"}
            </a>

            {/* Desktop Navigation */}
            <ul class="hidden lg:flex items-center gap-8 text-sm uppercase tracking-widest">
                <li>
                    <a 
                        href="/delivery-policies" 
                        class="text-brand-green hover:text-accent transition-colors duration-250 ease-smooth"
                        aria-current={currentPath === '/delivery-policies' ? 'page' : undefined}
                    >
                        {translations.es.delivery_policies}
                    </a>
                </li>
                <li>
                    <a 
                        href="/#shop" 
                        class="text-brand-green hover:text-accent transition-colors duration-250 ease-smooth"
                    >
                        {translations.es.shop}
                    </a>
                </li>
                <li>
                    <a 
                        href={whatsappUrl} 
                        target="_blank" 
                        rel="noopener noreferrer" 
                        class="text-brand-green hover:text-accent transition-colors duration-250 ease-smooth inline-flex items-center"
                        aria-label="Contactar por WhatsApp"
                    >
                        <span class="icon-[garden--whatsapp-fill-12] w-6 h-6" aria-hidden="true"></span> 
                    </a>
                </li>
            </ul>

            {/* Mobile Menu Toggle */}
            <mobile-menu-toggle class="lg:hidden">
                <button 
                    class="lg:hidden p-2 text-brand-green hover:text-accent transition-colors duration-250 ease-smooth rounded-lg focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-green focus-visible:ring-offset-2" 
                    aria-label="Abrir menú de navegación"
                    aria-expanded="false"
                    aria-controls="mobile-menu"
                >
                    <span class="menu-icon block w-6 h-6" aria-hidden="true">
                        <svg class="w-full h-full" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
                        </svg>
                    </span>
                    <span class="close-icon hidden w-6 h-6" aria-hidden="true">
                        <svg class="w-full h-full" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                        </svg>
                    </span>
                </button>
            </mobile-menu-toggle>
        </div>

        {/* Mobile Navigation Menu */}
        <div id="mobile-menu" class="lg:hidden hidden mt-4 pb-4 border-t border-border-light pt-4" aria-label="Menú de navegación móvil">
            <ul class="flex flex-col gap-4 text-sm uppercase tracking-widest">
                <li>
                    <a 
                        href="/#shop" 
                        class="block py-2 text-brand-green hover:text-accent transition-colors duration-250 ease-smooth" 
                    >
                        {translations.es.shop}
                    </a>
                </li>
                <li>
                    <a 
                        href="/delivery-policies" 
                        class="block py-2 text-brand-green hover:text-accent transition-colors duration-250 ease-smooth" 
                    >
                        {translations.es.delivery_policies}
                    </a>
                </li>
                <li class="flex justify-center gap-12 pt-8 border-t border-border-light">
                    <a 
                        href={`tel:+${SITE_WHATSAPP}`}
                        target="_blank" 
                        rel="noopener noreferrer" 
                        class="text-brand-green hover:text-accent transition-colors duration-250 ease-smooth"
                        aria-label="Llamar por teléfono"
                    >
                        <span class="icon-[topcoat--call] w-6 h-6" aria-hidden="true"></span>
                    </a>
                    <a 
                        href={whatsappUrl} 
                        target="_blank" 
                        rel="noopener noreferrer" 
                        class="text-brand-green hover:text-accent transition-colors duration-250 ease-smooth"
                        aria-label="Contactar por WhatsApp"
                    >
                        <span class="icon-[garden--whatsapp-fill-12] w-6 h-6" aria-hidden="true"></span> 
                    </a>
                </li>
            </ul>
        </div>
    </nav>
</header>

<script>
    class MobileMenuToggle extends HTMLElement {
        private button: HTMLButtonElement | null = null;
        private menu: HTMLElement | null = null;
        private isConnected = false;

        connectedCallback() {
            if (this.isConnected) return;
            this.isConnected = true;

            this.button = this.querySelector('button');
            this.menu = document.getElementById('mobile-menu');

            if (!this.button || !this.menu) return;

            this.button.addEventListener('click', this.handleToggle.bind(this));
            
            // Close on link click
            this.menu.querySelectorAll('a').forEach(link => {
                link.addEventListener('click', this.handleClose.bind(this));
            });

            // Close on escape key
            document.addEventListener('keydown', this.handleEscape.bind(this));
        }

        disconnectedCallback() {
            this.button?.removeEventListener('click', this.handleToggle.bind(this));
            document.removeEventListener('keydown', this.handleEscape.bind(this));
        }

        private handleToggle() {
            if (!this.button || !this.menu) return;

            const isExpanded = this.menu.classList.toggle('hidden') === false;
            this.button.setAttribute('aria-expanded', isExpanded.toString());
            
            // Toggle icons
            const menuIcon = this.button.querySelector('.menu-icon');
            const closeIcon = this.button.querySelector('.close-icon');
            
            if (menuIcon && closeIcon) {
                menuIcon.classList.toggle('hidden', isExpanded);
                closeIcon.classList.toggle('hidden', !isExpanded);
            }
        }

        private handleClose() {
            if (!this.button || !this.menu) return;

            this.menu.classList.add('hidden');
            this.button.setAttribute('aria-expanded', 'false');
            
            const menuIcon = this.button.querySelector('.menu-icon');
            const closeIcon = this.button.querySelector('.close-icon');
            
            if (menuIcon && closeIcon) {
                menuIcon.classList.remove('hidden');
                closeIcon.classList.add('hidden');
            }
        }

        private handleEscape(e: KeyboardEvent) {
            if (e.key !== 'Escape') return;
            
            const isExpanded = this.button?.getAttribute('aria-expanded') === 'true';
            if (isExpanded) {
                this.handleClose();
                this.button?.focus();
            }
        }
    }

    customElements.define('mobile-menu-toggle', MobileMenuToggle);
</script>