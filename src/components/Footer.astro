---
import { translations } from '../translations';
import { SITE_WHATSAPP } from '../consts';
import WhatsAppButton from './WhatsAppButton.astro';

const message = encodeURIComponent(`Hola, estoy interesado en los productos.`);
const whatsappUrl = `https://wa.me/${SITE_WHATSAPP}?text=${message}`;
---

<footer id="contact" class="bg-surface-cream border-t border-border-light py-4 sm:py-6 lg:py-8">
    <div class="container mx-auto px-4 sm:px-6">
        
        <div class="flex flex-col mx-8 sm:flex-row justify-between items-center text-[10px] uppercase tracking-widest text-text-light border-med-clay">
            <p class="mb-4 sm:mb-0" data-lang-target="copyright">{translations.es.copyright}</p>
            <div class="flex items-center gap-4">
                <a 
                    href={`tel:+${SITE_WHATSAPP}`}
			        target="_blank" 
			        rel="noopener noreferrer" 
			        class="flex items-center justify-center p-2 border border-brand-green/20 rounded-lg text-brand-green hover:bg-brand-green/5 transition-colors duration-250 ease-smooth md:hidden"
			        aria-label="Llamar por teléfono"
                >
			        <span class="icon-[topcoat--call] w-5 h-5"></span>
			    </a>
                <WhatsAppButton size="sm" />
            </div>
        </div>
    </div>
</footer>