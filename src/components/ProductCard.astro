---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

const { product } = Astro.props as {
  product: CollectionEntry<'products'>;
};

// Use product.id as the slug since it's used in getStaticPaths
const slug = product.id;
---

<article class="bg-white border border-stone-100 rounded-2xl pb-6 shadow-sm hover:shadow-xl transition-all duration-500 overflow-hidden group flex flex-col h-full">
    <a href={`/products/${slug}`} class="block flex-1">
        <div class="w-full aspect-square relative overflow-hidden bg-[#F7F6E4]">
            {product.data.heroImage && (
                <Image 
                    src={product.data.heroImage} 
                    alt={product.data.name} 
                    width={500} 
                    height={500} 
                    format="webp"
                    class="w-full h-full object-cover object-center transition-transform duration-700 group-hover:scale-110"
                    transition:name={`product-image-${product.id}`}
                />
            )}
            <div class="absolute inset-0 bg-black/0 group-hover:bg-black/5 transition-colors duration-500"></div>
        </div>

        <div class="w-full p-6 flex flex-col items-center text-center">
            <h3 
                class="font-playfair text-[#4B5E45] text-3xl md:text-4xl tracking-widest uppercase mb-2"
                transition:name={`product-name-${product.id}`}
            >
                {product.data.name}
            </h3>
            <span class="font-lora italic text-[#8B9B85] text-xs tracking-[0.2em] uppercase block mb-4">
                {product.data.title}
            </span>

            <div class="space-y-1 mb-6">
                {product.data.benefits.slice(0, 2).map((benefit: string) => (
                    <p class="text-stone-500 text-sm leading-relaxed m-0 italic">
                        {benefit}
                    </p>
                ))}
            </div>

            <div class="mt-4 pt-4 border-t border-stone-50 w-full">
                <h4 class="font-playfair font-bold text-[#576B51] text-xs uppercase tracking-widest mb-2" >
                    Extractos Principales
                </h4>
                <div class="flex flex-wrap justify-center gap-2">
                    {product.data.extracts.map((extract: string) => (
                        <span class="text-[#4B5E45] text-sm uppercase tracking-wider font-medium">
                            {extract}
                        </span>
                    ))}
                </div>
            </div>
        </div>
    </a>
    
    <div class="px-6 pb-2 flex justify-center">
        <a href={`/products/${slug}`} class="text-[#4B5E45] text-sm font-medium hover:text-med-terracotta transition-all duration-300 flex items-center gap-2 group/link">
            <span>Ver detalles</span>
            <span class="icon-[ph--arrow-right] w-4 h-4 transition-transform group-hover/link:translate-x-1"></span>
        </a>
    </div>
</article>