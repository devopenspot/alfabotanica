---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

const { product } = Astro.props as {
  product: CollectionEntry<'products'>;
};

const slug = product.id;
---

<article class="bg-white border border-border-light rounded-2xl pb-6 shadow-sm hover:shadow-xl transition-[border-color,box-shadow,background-color] duration-400 ease-smooth overflow-hidden group flex flex-col h-full">
    <a 
        href={`/products/${slug}`} 
        class="block flex-1 focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-green focus-visible:ring-offset-2 rounded-t-2xl"
    >
        <div class="w-full aspect-square relative overflow-hidden bg-surface-alt">
            {product.data.heroImage && (
                <Image 
                    src={product.data.heroImage} 
                    alt={product.data.name} 
                    width={500} 
                    height={500} 
                    format="webp"
                    class="w-full h-full object-cover object-center transition-transform duration-700 ease-smooth group-hover:scale-110"
                    transition:name={`product-image-${product.id}`}
                />
            )}
            <div class="absolute inset-0 bg-black/0 group-hover:bg-black/5 transition-colors duration-400 ease-smooth"></div>
        </div>

        <div class="w-full p-6 flex flex-col items-center text-center">
            <h3 
                class="font-playfair text-brand-green text-3xl md:text-4xl tracking-widest uppercase mb-2"
                transition:name={`product-name-${product.id}`}
            >
                {product.data.name}
            </h3>
            <span class="font-lora italic text-text-muted text-xs tracking-[0.2em] uppercase block mb-4">
                {product.data.title}
            </span>

            <div class="space-y-1 mb-6">
                {product.data.benefits.slice(0, 2).map((benefit: string) => (
                    <p class="text-text-muted text-sm leading-relaxed m-0 italic">
                        {benefit}
                    </p>
                ))}
            </div>

            <div class="mt-4 pt-4 border-t border-border-light w-full">
                <h4 class="font-playfair font-bold text-brand-green-light text-xs uppercase tracking-widest mb-2" >
                    Extractos Principales
                </h4>
                <div class="flex flex-wrap justify-center gap-2">
                    {product.data.extracts.map((extract: string) => (
                        <span class="text-brand-green text-sm uppercase tracking-wider font-medium">
                            {extract}
                        </span>
                    ))}
                </div>
            </div>
        </div>
    </a>
    
    <div class="px-6 pb-2 flex justify-center">
        <a 
            href={`/products/${slug}`} 
            class="text-brand-green text-sm font-medium hover:text-accent transition-colors duration-250 ease-smooth flex items-center gap-2 group/link focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-green focus-visible:ring-offset-2 rounded"
        >
            <span>Ver detalles</span>
            <span class="icon-[ph--arrow-right] w-4 h-4 transition-transform duration-250 ease-smooth group-hover/link:translate-x-1"></span>
        </a>
    </div>
</article>