---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Shop from '../components/Shop.astro';	
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import ShareButton from '../components/ShareButton.astro';
import BackButton from '../components/BackButton.astro';

type Props = CollectionEntry<'products'>['data'];

const { id, name, title, description, heroImage, price, benefits, extracts, useMode, ...rest } = Astro.props;

const seoDescription = description?.slice(0, 160) + (description?.length > 160 ? '...' : '');
const seoTitle = `${name} - ${title}`;

const displayPrice = price?.[0]?.split('$')?.[1]?.replace(/\./g, '') || "";
---

<html lang="es">
	<head>
		<BaseHead 
			title={seoTitle} 
			description={seoDescription} 
			heroImage={heroImage} 
			type="product"
			price={displayPrice}
			category="Botanical"
			keywords={[name, ...extracts]}
		/>
	</head>

	<body class="bg-surface-alt text-brand-green">
		<Header />

		<main class="text-brand-green overflow-hidden">

			<!-- Hero Section -->
			<!-- <div class="w-full bg-brand-green relative overflow-hidden py-12 lg:py-20 flex flex-col items-center">
				<div class="absolute inset-0 opacity-10 pointer-events-none">
					<div class="absolute inset-0 bg-[radial-gradient(#ffffff_1px,transparent_1px)] [background-size:20px_20px]"></div>
				</div>
				
				<div class="relative z-10 text-center px-4">
					<h1 
						class="font-playfair text-white text-4xl md:text-6xl lg:text-7xl tracking-widest uppercase mb-4 drop-shadow-sm"
						transition:name={`product-name-${id}`}
					>
						{name}
					</h1>
					<div class="h-px w-24 bg-white/30 mx-auto my-6"></div>
					<span class="font-lora italic text-white/90 text-sm md:text-base tracking-[0.3em] uppercase block">
						{title}
					</span>
				</div>
			</div> -->

			<!-- Product Details -->
			<div class="container mx-auto px-4 py-12 lg:py-16 max-w-7xl">
				<div class="flex flex-col lg:flex-row gap-12 lg:gap-20">
					
					<div class="w-full lg:w-1/2">
						{heroImage && (
							<div 
								class="aspect-square relative rounded-2xl overflow-hidden shadow-[0_20px_50px_rgba(0,0,0,0.1)] group bg-white p-4"
							>
								<Image
									src={heroImage}
									alt={`${name} - ${title}`}
									width={1000}
									height={1000}
									loading="eager"
									format="webp" 
									quality="high"
									widths={[400, 800, 1200]}
									sizes="(max-width: 1024px) 100vw, 50vw"
									class="w-full h-full object-cover rounded-xl transition-transform duration-700 ease-smooth group-hover:scale-105"
									transition:name={`product-image-${id}`}
								/>
							</div>
						)}
					</div>

					<!-- Right: Info -->
					<div class="w-full lg:w-1/2 flex flex-col">
						<div class="prose prose-stone max-w-none mb-10">
							<p class="text-lg md:text-xl text-brand-green-light leading-relaxed mb-8">
								{description}
							</p>

							{benefits && (
								<div class="mb-10">
									<h3 class="font-playfair text-2xl mb-4 text-brand-green border-b border-brand-green/10 pb-2">Beneficios</h3>
									<ul class="grid grid-cols-1 md:grid-cols-2 gap-4 list-none p-0">
										{benefits.map((benefit) => (
											<li class="flex items-start gap-3 text-sm md:text-md">
												<span class="mt-1 text-brand-green flex-shrink-0">
													<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
														<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
													</svg>
												</span>
												<span>{benefit}</span>
											</li>
										))}
									</ul>
								</div>
							)}

							{useMode && (
								<div class="mb-10 bg-brand-green/5 p-6 rounded-xl border-l-4 border-brand-green">
									<h3 class="font-playfair text-xl mb-3 text-brand-green uppercase tracking-wide">Modo de Uso</h3>
									<p class="text-sm md:text-base italic leading-relaxed m-0 opacity-80">
										{useMode}
									</p>
								</div>
							)}
						</div>

						<!-- Price & Actions -->
						<div class="mt-auto pt-8 border-t border-border-light">
							{price && (
								<div class="mb-8">
									<span class="text-xs uppercase tracking-[0.2em] text-text-light block mb-3">Opciones de Compra</span>
									<div class="flex flex-wrap gap-3">
										{price.map((item) => (
											<span class="px-4 py-2 bg-white border border-border-light rounded-lg shadow-sm text-brand-green font-medium">
												{item}
											</span>
										))}
									</div>
								</div>
							)}

							<div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
								<WhatsAppButton productName={`${name} ${title}`} sku={id.toString()} />
								<ShareButton />
								<BackButton />
							</div>
						</div>
					</div>
				</div>
			</div>

			<!-- More Products -->
			<section class="w-full bg-white border-t border-border-light py-16">
				<div class="container mx-auto px-4">
					<h2 class="font-playfair text-center text-3xl mb-12 text-brand-green">Descubre más</h2>
					<Shop />
				</div>
			</section>
		</main>

		<Footer />
	</body>
</html>
