---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Shop from '../components/Shop.astro';
import CallToAction from '../components/CallToAction.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import alfabotanicaImage from '../assets/img/alfabotanica.png';
---

<BaseLayout 
	title={SITE_TITLE} 
	description={SITE_DESCRIPTION} 
	heroImage={alfabotanicaImage} 
	type="website"
	keywords={["botánica", "natural", "cuidado personal", "pureza", "plantas"]}
	bodyClass="bg-white text-text-main"
>
	<Hero />
	<Shop />
	<CallToAction />
</BaseLayout>
