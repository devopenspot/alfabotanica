---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { 
	SITE_TITLE, 
	SITE_DESCRIPTION, 
	SITE_URL,
	SITE_WHATSAPP,
	SITE_EMAIL,
	SITE_LOGO,
	SITE_CITY,
	SITE_DEPARTMENT,
	SITE_COUNTRY,
	SITE_LATITUDE,
	SITE_LONGITUDE,
	SITE_OPENING_HOURS,
} from '../consts';
import alfabotanicaImage from '../assets/img/alfabotanica.png';
import { ClientRouter } from 'astro:transitions';
import { generateStructuredData } from '../utils/seo';

const pageTitle = "Guía de Compra | " + SITE_TITLE;
const pageDescription = "Sigue estos sencillos pasos para realizar tu compra en Alfabotanica y recibir tus productos de forma rápida y segura.";

const faqSchema = generateStructuredData({
	organization: {
		name: SITE_TITLE,
		url: SITE_URL,
		logo: new URL(SITE_LOGO, SITE_URL).toString(),
		phone: SITE_WHATSAPP,
		email: SITE_EMAIL,
	},
	website: {
		name: SITE_TITLE,
		url: SITE_URL,
		description: SITE_DESCRIPTION,
	},
	faq: {
		mainEntity: [
			{
				question: "¿Cómo realizo una compra en Alfa Botánica?",
				answer: "Para realizar una compra, primero debes contactarnos vía WhatsApp o llamada telefónica para verificar la disponibilidad del producto. Una vez confirmada la disponibilidad, te proporcionaremos los datos de pago y podrás proceder con la transacción."
			},
			{
				question: "¿Cuáles son los métodos de pago aceptados?",
				answer: "Aceptamos pagos exclusivamente a través de Nequi. Una vez que confirmemos la disponibilidad de tu producto, te proporcionaremos los datos de la cuenta Nequi para realizar el pago."
			},
			{
				question: "¿Realizan envíos a nivel nacional?",
				answer: "Sí, realizamos envíos a todo Colombia a través de Interrapidísimo. El costo del envío es asignado directamente por la agencia de transporte."
			},
			{
				question: "¿Cómo puedo rastrear mi pedido?",
				answer: "Una vez enviado tu pedido, te proporcionaremos el número de guía para que puedas rastrear tu pedido en tiempo real a través del sitio web de Interrapidísimo."
			},
			{
				question: "¿Cuál es el tiempo de entrega?",
				answer: "Los tiempos de entrega varían según la ubicación. Una vez confirmado el pago, procesamos el pedido y te enviamos el número de guía. El tiempo de tránsito depende de la agencia de transporte."
			},
			{
				question: "¿Qué debo hacer después de realizar el pago?",
				answer: "Después de realizar el pago, es obligatorio enviar el comprobante de transferencia exclusivamente vía WhatsApp. No procesaremos pedidos sin el comprobante de pago."
			}
		]
	}
});
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title={pageTitle} description={pageDescription} heroImage={alfabotanicaImage} />
		<script type="application/ld+json" set:html={faqSchema} />
		<ClientRouter />
		<style>
			.step-number {
				@apply flex-shrink-0 w-10 h-10 md:w-12 md:h-12 rounded-full bg-[#4B5E45] inline-flex items-center justify-center text-white relative z-10 font-bold text-lg md:text-xl shadow-lg shadow-green-900/10;
			}
			.step-line {
				@apply h-full w-0.5 absolute inset-0 left-5 md:left-6 flex items-center justify-center bg-stone-200 pointer-events-none;
			}
			.step-container {
				@apply flex relative pb-12 md:pb-16 last:pb-0;
			}
			.step-content {
				@apply flex-grow pl-6 md:pl-10;
			}
			.timeline-content {
				@apply bg-white rounded-[2rem] md:rounded-[2.5rem] shadow-2xl shadow-stone-200/40 p-6 sm:p-10 md:p-16 border border-stone-100;
			}
		</style>
	</head>
	<body class="bg-surface-alt text-brand-green">

		<Header />
		
		<main class="flex-1 py-10 sm:py-16 md:py-24" transition:animate="fade" id="main-content">
			<div class="max-w-4xl mx-auto px-4 sm:px-6">
				<header class="text-center mb-12 sm:mb-20">
					<span class="inline-block px-4 py-1.5 mb-4 sm:mb-6 text-[10px] sm:text-xs font-bold tracking-[0.3em] uppercase bg-brand-green/10 text-brand-green rounded-full">Proceso de Compra</span>
					<h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold text-text-main mb-4 sm:mb-8 font-lora italic leading-tight">Guía de Compra: Paso a Paso</h1>
					<p class="text-base sm:text-lg md:text-xl text-text-muted max-w-2xl mx-auto leading-relaxed px-2">
						¡Gracias por elegirnos! Para que recibas tus productos de forma rápida y segura, hemos diseñado este sencillo proceso.
					</p>
				</header>

				<div class="timeline-content">
					<!-- Step 1 -->
					<div class="step-container">
						<div class="step-line"></div>
						<div class="step-number">1</div>
						<div class="step-content">
							<h3 class="text-xl sm:text-2xl font-bold text-text-main mb-3 sm:mb-4 font-lora">Consulta de Disponibilidad</h3>
							<p class="text-text-muted leading-relaxed mb-6 text-base sm:text-lg">
								Antes de realizar cualquier pago, contáctanos vía <span class="font-bold text-brand-green">WhatsApp</span> o llamada telefónica. Confirmaremos en tiempo real si el producto está disponible.
							</p>
							<div class="flex">
								<WhatsAppButton size="md" />
							</div>
						</div>
					</div>

					<!-- Step 2 -->
					<div class="step-container">
						<div class="step-line"></div>
						<div class="step-number">2</div>
						<div class="step-content">
							<h3 class="text-xl sm:text-2xl font-bold text-text-main mb-3 sm:mb-4 font-lora">Datos para el Pago</h3>
							<p class="text-text-muted leading-relaxed text-base sm:text-lg">
								Una vez confirmada la disponibilidad, te proporcionaremos los datos de nuestra cuenta <span class="font-bold text-[#E91E63]">Nequi</span> para proceder con la transacción de forma segura.
							</p>
						</div>
					</div>

					<!-- Step 3 -->
					<div class="step-container">
						<div class="step-line"></div>
						<div class="step-number">3</div>
						<div class="step-content">
							<div class="flex flex-col sm:flex-row sm:items-center gap-2 mb-3 sm:mb-4">
								<h3 class="text-xl sm:text-2xl font-bold text-text-main font-lora">Reporte de Pago</h3>
								<span class="w-fit text-red-600 text-[10px] sm:text-xs font-bold bg-red-50 px-2 sm:px-3 py-1 rounded-md uppercase tracking-wider">Muy importante</span>
							</div>
							<p class="text-text-muted leading-relaxed mb-6 text-base sm:text-lg">
								Para procesar tu pedido, es <span class="font-bold border-b-2 border-red-200">obligatorio</span> cumplir con lo siguiente:
							</p>
							<div class="grid gap-3 sm:gap-4 mb-6">
								<div class="flex items-start sm:items-center p-4 bg-gray-50 rounded-2xl border border-gray-200 transition-colors duration-250 ease-smooth hover:bg-gray-100/50">
									<div class="w-8 h-8 sm:w-10 sm:h-10 bg-brand-green/10 rounded-full flex items-center justify-center mr-3 sm:mr-4 flex-shrink-0">
										<svg class="w-5 h-5 sm:w-6 sm:h-6 text-brand-green" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
									</div>
									<span class="text-text-main font-medium text-sm sm:text-base">Enviar el comprobante de transferencia.</span>
								</div>
								<div class="flex items-start sm:items-center p-4 bg-gray-50 rounded-2xl border border-gray-200 transition-colors duration-250 ease-smooth hover:bg-gray-100/50">
									<div class="w-8 h-8 sm:w-10 sm:h-10 bg-brand-green/10 rounded-full flex items-center justify-center mr-3 sm:mr-4 flex-shrink-0">
										<svg class="w-5 h-5 sm:w-6 sm:h-6 text-brand-green" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
									</div>
									<span class="text-text-main font-medium text-sm sm:text-base">El envío debe ser exclusivamente vía WhatsApp.</span>
								</div>
							</div>
							<div class="flex justify-start">
								<WhatsAppButton size="sm" className="bg-brand-green text-white hover:bg-brand-green-dark border-transparent" />
							</div>
						</div>
					</div>

					<!-- Step 4 -->
					<div class="step-container">
						<div class="step-line"></div>
						<div class="step-number">4</div>
						<div class="step-content">
							<h3 class="text-xl sm:text-2xl font-bold text-text-main mb-3 sm:mb-4 font-lora">Verificación</h3>
							<p class="text-text-muted leading-relaxed text-base sm:text-lg italic">
								Validaremos el ingreso del dinero en Nequi. Este proceso es rápido y esencial para autorizar el despacho de tus productos.
							</p>
						</div>
					</div>

					<!-- Step 5 -->
					<div class="flex relative">
						<div class="step-number">5</div>
						<div class="step-content">
							<h3 class="text-xl sm:text-2xl font-bold text-text-main mb-3 sm:mb-4 font-lora">Envío y Seguimiento</h3>
							<p class="text-text-muted leading-relaxed mb-6 text-base sm:text-lg">
								¡Tu pedido se pone en marcha! 
							</p>
							<div class="bg-surface-alt p-5 sm:p-8 rounded-[1.5rem] sm:rounded-[2rem] mb-6 border border-gray-200">
								<div class="flex items-center mb-4">
									<div class="w-10 h-10 sm:w-12 sm:h-12 bg-white rounded-xl sm:rounded-2xl flex items-center justify-center shadow-sm mr-3 sm:mr-4">
										<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 sm:w-6 sm:h-6 text-brand-green" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
											<path stroke-linecap="round" stroke-linejoin="round" d="M9 17a2 2 0 11-4 0 2 2 0 014 0zM19 17a2 2 0 11-4 0 2 2 0 014 0z" />
											<path stroke-linecap="round" stroke-linejoin="round" d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8-1a1 1 0 01-1 1H9m4-1V8a1 1 0 011-1h2.586a1 1 0 01.707.293l3.414 3.414a1 1 0 01.293.707V16a1 1 0 01-1 1h-1m-6-1a1 1 0 001 1h1M5 17a2 2 0 104 0m-4 0a2 2 0 114 0m6 0a2 2 0 104 0m-4 0a2 2 0 114 0" />
										</svg>
									</div>
									<p class="text-brand-green font-bold text-lg sm:text-xl font-lora italic">Logística Aliada</p>
								</div>
								<p class="text-text-main leading-relaxed text-sm sm:text-base">
									Realizamos todos nuestros envíos a través de <span class="font-bold text-text-main">Interrapidísimo</span>, garantizando total cobertura.
								</p>
							</div>
							<p class="text-text-muted leading-relaxed text-base sm:text-lg">
								Te enviaremos el <span class="font-bold text-text-main underline decoration-brand-green/30">número de guía</span> para que rastrees tu pedido en tiempo real hasta su entrega.
							</p>
						</div>
					</div>
				<div class="mt-12 bg-white rounded-[2.5rem] p-8 sm:p-12 border border-stone-100 shadow-2xl shadow-stone-200/40 relative overflow-hidden">
					<div class="absolute top-0 right-0 w-32 h-32 bg-brand-green/5 rounded-bl-full -mr-16 -mt-16"></div>
					<h3 class="text-2xl sm:text-3xl font-bold text-text-main mb-8 font-lora italic relative z-10">Políticas de Envío</h3>
					
					<div class="grid gap-6 relative z-10">
						<div class="flex items-start gap-4 p-5 rounded-2xl bg-gray-50/50 hover:bg-gray-50 transition-colors duration-250 ease-smooth border border-transparent hover:border-gray-200">
							<div class="w-10 h-10 bg-brand-green/10 rounded-xl flex items-center justify-center flex-shrink-0">
								<span class="text-brand-green font-bold">1</span>
							</div>
							<p class="text-text-muted leading-relaxed pt-1">
								Realizamos envíos <span class="font-bold text-text-main">únicamente en Colombia</span>.
							</p>
						</div>

						<div class="flex items-start gap-4 p-5 rounded-2xl bg-gray-50/50 hover:bg-gray-50 transition-colors duration-250 ease-smooth border border-transparent hover:border-gray-200">
							<div class="w-10 h-10 bg-brand-green/10 rounded-xl flex items-center justify-center flex-shrink-0">
								<span class="text-brand-green font-bold">2</span>
							</div>
							<p class="text-text-muted leading-relaxed pt-1">
								El costo del envío es asignado directamente por la <span class="font-bold text-text-main">agencia de transporte</span>.
							</p>
						</div>
					</div>
				</div>
				
				<div class="mt-16 sm:mt-24 text-center">
					<div class="inline-block w-full sm:w-auto p-8 sm:p-12 bg-white rounded-[2rem] sm:rounded-[3rem] shadow-2xl shadow-stone-200/40 border border-stone-100 sm:max-w-lg mx-auto">
						<h4 class="text-xl sm:text-2xl font-bold text-text-main mb-3 sm:mb-4 font-lora italic">¿Listo para empezar?</h4>
						<p class="text-text-muted mb-8 sm:mb-10 leading-relaxed text-sm sm:text-base">Contáctanos ahora y te guiaremos en cada paso de tu compra.</p>
						<WhatsAppButton size="lg" variant="full" />
					</div>
				</div>
			</div>
		</main>

		<Footer />
	</body>
</html>